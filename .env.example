# Copy to .env.local and fill in. NEVER commit real values (this repo is public).
# Every variable is documented in docs/SETUP.md#5-environment-variables.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public: shipped to the browser, protected by RLS) -------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (secret: server only, bypasses RLS) ----------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase CLI in CI only (GitHub Actions secrets, not needed locally) -----
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
# SUPABASE_DB_PASSWORD=your-database-password

# --- M-Pesa Daraja (secret) ---------------------------------------------------
# mock: no Safaricom account needed; the app fakes the prompt and calls its own
#       callback route (local dev, CI, demos). Needs only MPESA_CALLBACK_SECRET
#       and SUPABASE_SERVICE_ROLE_KEY. Phones ending 1032 cancel, 0001 fail.
# sandbox | production: real Daraja; every variable below is required.
# Leave MPESA_ENV unset to hide the M-Pesa buttons entirely.
MPESA_ENV=mock
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
# Generate with: openssl rand -hex 32 (min 16 characters outside mock)
MPESA_CALLBACK_SECRET=change-me-random-hex
# Public HTTPS (use a tunnel locally). Must end with /api/mpesa/callback/<MPESA_CALLBACK_SECRET>.
MPESA_CALLBACK_URL=https://your-tunnel.example/api/mpesa/callback/change-me-random-hex
# Optional: comma-separated source IPs allowed to call the callback (empty = no IP check).
# MPESA_CALLBACK_ALLOWED_IPS=
# --- Tests (optional) ---------------------------------------------------------
# Mailpit inbox used by Playwright to read magic-link emails (local default shown).
# MAILPIT_URL=http://127.0.0.1:54324
